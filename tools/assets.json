{
  "_doc": "build_assets.py 的設定。view 欄位見 tools/render/render.html：yaw/pitch 是相機角度（度），exposure 曝光，key/fillLight/rim 主光/補光/背光強度，tone = aces|neutral|agx。grade 是只套在這隻身上的後製調色（gamma/gain/lift/contrast/sat/tint）。spin.pitch 可以讓轉盤用不同俯角（預設和靜態圖一樣，第 0 格 = 靜態圖）。",
  "sprite": { "size": 256, "render": 1024 },
  "spin": { "frames": 24, "cols": 6, "rows": 4, "size": 192, "render": 384, "webpQuality": 85 },
  "defaults": {
    "view": { "pitch": 14, "exposure": 1.0, "tone": "neutral", "key": 1.6, "fillLight": 0.5, "rim": 1.2, "fill": 0.95 }
  },
  "pieces": [
    { "id": "dog", "source": "scan",
      "view": { "yaw": 290, "pitch": 22, "exposure": 2.4, "key": 2.2, "fillLight": 1.0, "rim": 6 },
      "grade": { "gamma": 0.78, "gain": 1.08, "contrast": 1.15, "tint": [1.05, 1.0, 0.94] } },
    { "id": "sloth", "source": "scan",
